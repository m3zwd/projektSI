{% extends 'base.html.twig' %}

{% block title %}
    {{ recipe.title }}
{% endblock %}

{% block title_header %}
    <h1>{{ recipe.title }}</h1>
{% endblock %}

{% block body %}
    {% if recipe is defined and recipe|length %}

        {# Dane przepisu #}
        <dl class="dl-horizontal">
            {% if is_granted('ROLE_ADMIN') %}
                <dt>{{ 'label.id'|trans }}</dt>
                <dd>{{ recipe.id }}</dd>
            {% endif %}
            <dt>{{ 'label.created_at'|trans }}</dt>
            <dd>{{ recipe.createdAt|format_date('long') }}</dd>
            <dt>{{ 'label.updated_at'|trans }}</dt>
            <dd>{{ recipe.updatedAt|format_date('long') }}</dd>
            <dt>{{ 'label.category'|trans }}</dt>
            <dd>{{  recipe.category.title }}</dd>
            <dt>{{ 'label.author'|trans }}</dt>
            <dd>{{  recipe.author.email }}</dd>
            <dt>{{ 'label.tags'|trans }}</dt>
            <dd>
                {% if recipe.tags|length > 0 %}
                    {% for tag in recipe.tags %}
                        <span class="badge bg-secondary">{{ tag.title }}</span>
                    {% endfor %}
                {% else %}
                    <span class="text-muted">{{ 'label.none'|trans }}</span>
                {% endif %}
            </dd>
        </dl>

        {# Instrukcja #}
        <div class="bg-light border rounded p-3">
            {{ recipe.instruction|markdown_to_html }}
        </div>

        {# Lista komentarzy #}
        <hr>
        <h2>{{ 'label.comments'|trans }}</h2>
        {% if recipe.comments|length > 0 %}
            <ul class="list-group mb-4">
                {% for comment in recipe.comments %}
                    <li class="list-group-item">
                        <strong>{{ comment.author.email }}</strong>
                        {# to jest takie długie, bo samo "format_datetime('long', 'short')" nie pokazywało przecinka pomiedzy datą i godziną #}
                        <small>({{ comment.createdAt|format_date('long') }}, {{ comment.createdAt|format_time('short') }})</small>

                        {# Formularz edycji komentarza #}
                        {% if edit_comment is defined and edit_comment and edit_comment.id == comment.id %}
                            {{ form_start(edit_comment_form) }}
                                <input type="hidden" name="edit_comment_id" value="{{ edit_comment.id }}">
                                {{ form_row(edit_comment_form.content) }}
                                <button type="submit" class="btn btn-primary btn-sm">{{ 'action.save'|trans }}</button>
                            {{ form_end(edit_comment_form) }}
                        {% else %}
                            <p>{{ comment.content }}</p>

                            {# Przyciski do edycji i usuwania komentarza
                            (ukryte domyślnie, widoczne tylko jeśli użytkownik ma uprawnienia, czyli jest autorem komentarza lub adminem) #}
                            {% if is_granted('COMMENT_EDIT', comment) %}
                                <form method="post" action="{{ path('recipe_view', {'id': recipe.id}) }}" style="display: inline-block;">
                                    <input type="hidden" name="edit_comment_id" value="{{ comment.id }}">
                                    <button type="submit" class="btn btn-outline-primary btn-sm">{{ 'action.edit'|trans }}</button>
                                </form>
                            {% endif %}

                            {% if is_granted('COMMENT_DELETE', comment) %}
                                <form method="post" action="{{ path('recipe_view', {'id': recipe.id}) }}" onsubmit="return confirm('{{ 'message.confirm_delete'|trans }}')" style="display: inline-block;">
                                    <input type="hidden" name="delete_comment_id" value="{{ comment.id }}">
                                    <button type="submit" class="btn btn-outline-danger btn-sm">{{ 'action.delete'|trans }}</button>
                                </form>
                            {% endif %}
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <p class="text-muted">{{ 'message.no_comments'|trans }}</p>
        {% endif %}

        {# Formularz dodawania komentarzy
        (ukryty domyślnie, widoczny jeśli uzytkownik jest zalogowany, po kliknieciu przycisku) #}
        {% if app.user %}
            <button class="btn btn-primary mb-3" onclick="toggleCommentForm()">
                {{ 'action.add_comment'|trans }}
            </button>

            <div id="comment-form" style="display: none;">
                {{ form_start(comment_form) }}
                {{ form_row(comment_form.content) }}
                <button type="submit" class="btn btn-primary">{{ 'action.save'|trans }}</button>
                {{ form_end(comment_form) }}
            </div>

            <script>
                function toggleCommentForm() {
                    const formDiv = document.getElementById('comment-form');
                    formDiv.style.display = formDiv.style.display === 'none' ? 'block' : 'none';
                }
            </script>
        {% else %}
            <p class="text-muted">{{ 'message.login_to_comment'|trans }}</p>
        {% endif %}

        {# Oceny #}
        <hr>
        <h2>{{ 'label.ratings'|trans }}</h2>
        {# Średnia ocen #}
        <p><strong>{{ 'label.average_rating'|trans }}:</strong> ⭐ {{ recipe.averageRating|number_format(1) }} / 5</p>

        {# Lista ocen #}
        {% if recipe.ratings is not empty %}
            <ul class="list-group mb-4">
                {% for rating in recipe.ratings %}
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span>
                            ⭐ {{ rating.value }} / 5 –
                            <strong>{{ rating.author.email }}</strong>
                            <small>({{ rating.createdAt|format_date('long') }}, {{ rating.createdAt|format_time('short') }})</small>
                        </span>
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <p class="text-muted">{{ 'message.no_ratings'|trans }}</p>
        {% endif %}

        {# Formularz dodawania ocen
        (ukryty domyślnie, widoczny jeśli uzytkownik jest zalogowany, po kliknieciu przycisku) #}
        {% if app.user %}
            <button class="btn btn-warning mb-3" onclick="toggleRatingForm()">
                {{ 'action.add_rating'|trans }}
            </button>

            <div id="rating-form" style="display: none;">
                {{ form_start(rating_form) }}
                {{ form_row(rating_form.value) }}
                <button type="submit" class="btn btn-warning">{{ 'action.save'|trans }}</button>
                {{ form_end(rating_form) }}
            </div>

            <script>
                function toggleRatingForm() {
                    const formDiv = document.getElementById('rating-form');
                    formDiv.style.display = formDiv.style.display === 'none' ? 'block' : 'none';
                }
            </script>
        {% else %}
            <p class="text-muted">{{ 'message.login_to_rate'|trans }}</p>
        {% endif %}

        <p>
            <a href="{{ url('recipe_index') }}" title="{{ 'action.back_to_list'|trans }}">
                {{ 'action.back_to_list'|trans }}
            </a>
        </p>
    {% else %}
        <p>
            {{ 'message.record_not_found'|trans }}
        </p>
    {% endif %}
{% endblock %}