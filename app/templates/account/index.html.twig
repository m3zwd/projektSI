{% extends 'base.html.twig' %}

{% block title %}
    {{ 'title.account'|trans }}
{% endblock %}

{% block title_header %}
    <h1>{{ 'title.account'|trans }}</h1>
{% endblock %}

{% block body %}
    {% if user is defined and user|length %}

        {# Moje dane #}
        <dl class="dl-horizontal">
            <dt>{{ 'label.email'|trans }}</dt>
            <dd>{{ user.email }}</dd>
            {% if is_granted('ROLE_ADMIN') %}
                <dt>{{ 'label.roles'|trans }}</dt>
                <dd>
                    {% for role in user.roles %}
                        {% if role == 'ROLE_ADMIN' %}
                            <div class="btn btn-secondary btn-sm">{{ 'role.admin'|trans }}</div>
                        {% elseif role == 'ROLE_USER' %}
                            <div class="btn btn-outline-secondary btn-sm">{{ 'role.user'|trans }}</div>
                        {% endif %}
                    {% endfor %}
                </dd>
            {% endif %}
        </dl>

        {# Akcje #}
        <p>
            <a class="btn btn-outline-primary btn-sm" href="{{ path('account_edit', {id: user.id}) }}" title="{{ 'action.account_edit'|trans }}">
                <i class="fas fa-pen me-1"></i> {{ 'action.account_edit'|trans }}
            </a>
            <a class="btn btn-outline-primary btn-sm" href="{{ path('account_change_password', {id: user.id}) }}" title="{{ 'action.change_password'|trans }}">
                <i class="fas fa-pen me-1"></i> {{ 'action.change_password'|trans }}
            </a>
        </p>

        {# Moje przepisy #}
        <h2>{{ 'title.my_recipes'|trans }}</h2>
        {% if recipes is defined and recipes|length %}
            <ul>
                {% for recipe in recipes %}
                    <li>
                        <a href="{{ url('recipe_view', {id: recipe.id}) }}">
                            {{ recipe.title }}
                        </a>
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <p>{{ 'label.none'|trans }}</p>
            <p>
                <a href="{{ url('recipe_create') }}" class="btn btn-primary">
                    {{ 'action.recipe_create'|trans }}
                </a>
            </p>
        {% endif %}

    {% else %}
        <p>
            {{ 'message.record_not_found'|trans }}
        </p>
    {% endif %}
{% endblock %}