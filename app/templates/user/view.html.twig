{% extends 'base.html.twig' %}

{% block title %}
    {{ 'label.user'|trans }}: {{ user.email }}
{% endblock %}

{% block title_header %}
    <h1>{{ user.email }}</h1>
{% endblock %}

{% block body %}
    {% if user is defined and user|length %}
        {# Dane użytkownika #}
        <dl class="dl-horizontal">
            <dt>{{ 'label.id'|trans }}</dt>
            <dd>{{ user.id }}</dd>
            <dt>{{ 'label.email'|trans }}</dt>
            <dd>{{ user.email }}</dd>
            <dt>{{ 'label.roles'|trans }}</dt>
            <dd>
                {% for role in user.roles %}
                    {% if role == 'ROLE_ADMIN' %}
                        <span class="badge bg-secondary">{{ 'role.admin'|trans }}</span>
                    {% elseif role == 'ROLE_USER' %}
                        <span class="badge bg-light text-dark">{{ 'role.user'|trans }}</span>
                    {% endif %}
                {% endfor %}
            </dd>
            <dt>{{ 'label.block_status'|trans }}</dt>
            <dd>
                {% if user.isBlocked() %}
                    <span class="text-danger">{{ 'label.blocked'|trans }}</span>
                {% else %}
                    <span class="text-success">{{ 'label.unblocked'|trans }}</span>
                {% endif %}
            </dd>
        </dl>

        <p>
            <a class="btn btn-outline-primary btn-sm" href="{{ path('user_change_password', {id: user.id}) }}" title="{{ 'action.change_user_password'|trans }}">
                <i class="fas fa-pen me-1"></i> {{ 'action.change_user_password'|trans }}
            </a>
            <a class="btn btn-outline-primary btn-sm" href="{{ path('user_change_role', {id: user.id}) }}" title="{{ 'action.change_role'|trans }}">
                <i class="fas fa-pen me-1"></i> {{ 'action.change_role'|trans }}
            </a>
            {% if user.isBlocked %}
                {% set blockLabel = 'action.unblock'|trans %}
            {% else %}
                {% set blockLabel = 'action.block'|trans %}
            {% endif %}
            <a class="btn btn-outline-dark btn-sm" href="{{ path('user_block', {id: user.id}) }}" title="{{ blockLabel }}">
                <i class="fa-solid fa-lock me-1"></i>{{ blockLabel }}
            </a>

            <a class="btn btn-outline-danger btn-sm" href="{{ path('user_delete', {id: user.id}) }}" title="{{ 'action.delete'|trans }}">
                <i class="fa-regular fa-trash-can me-1"></i> {{ 'action.delete'|trans }}
            </a>
        </p>

        {# Lista przepisów użytkownika #}
        <h2>{{ 'title.user_recipes'|trans }}</h2>
        {% if recipes is defined and recipes|length %}
            <ul>
                {% for recipe in recipes %}
                    <li>
                        <a href="{{ url('recipe_view', {id: recipe.id}) }}">
                            {{ recipe.title }}
                        </a>
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <p>{{ 'message.no_recipes_for_user'|trans }}</p>
        {% endif %}

        <p>
            <a href="{{ url('user_index') }}" title="{{ 'action.back_to_list'|trans }}">
                {{ 'action.back_to_list'|trans }}
            </a>
        </p>
    {% else %}
        <p>
            {{ 'message.record_not_found'|trans }}
        </p>
    {% endif %}
{% endblock %}